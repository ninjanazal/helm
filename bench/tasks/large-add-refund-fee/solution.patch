diff --git a/src/payments/fees.sh b/src/payments/fees.sh
index d0d067c..21eedde 100644
--- a/src/payments/fees.sh
+++ b/src/payments/fees.sh
@@ -4,3 +4,11 @@
 payments_fee() {
   printf '%s' $(( $1 * 29 / 1000 + 30 ))
 }
+
+# payments_refund_fee <cents>: the payment fee, capped at 1000; 0 under 100 cents.
+payments_refund_fee() {
+  [ "$1" -lt 100 ] && { printf 0; return 0; }
+  f=$(payments_fee "$1")
+  [ "$f" -gt 1000 ] && f=1000
+  printf '%s' "$f"
+}
